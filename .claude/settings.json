{
  "permissions": {
    "allow": [
      "Bash(anchor build:*)",
      "Bash(anchor test:*)",
      "Bash(CARGO_BUILD_JOBS=4 anchor build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(solana balance:*)",
      "Bash(solana address:*)",
      "Bash(solana config get:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(solana-keygen:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /:*)",
      "Bash(anchor deploy --provider.cluster mainnet:*)",
      "Bash(solana config set --url mainnet:*)",
      "Read(~/.config/solana/**)",
      "Edit(~/.config/solana/**)",
      "Read(./.env)",
      "Edit(./.env)"
    ]
  }
}
