# Copy to .env.local and fill in.

# A devnet SPL token mint you control (mint authority = your CLI wallet),
# used as the "USDC" for creating events. Same mint as scripts/seed-demo.ts's
# USDC_MINT. Create one with: spl-token create-token --url devnet
NEXT_PUBLIC_USDC_MINT=

# Optional: override the default public devnet RPC endpoint.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public URL this app is reachable at. Only matters for the Solana Pay QR
# code on the event page: a phone scanning it needs to reach this URL, so
# it must be a public tunnel (e.g. ngrok) or your Vercel deployment —
# never localhost. Defaults to http://localhost:3000 for local dev.
# NEXT_PUBLIC_APP_URL=https://your-tunnel-or-deployment.example
